+    private suspend fun analyzeReceipt(bitmap: Bitmap, onResult: (List<Product>) -> Unit) {
+        withContext(Dispatchers.IO) {
+            try {
+                val prompt = """
+                    Du bist ein präziser Kassenbon-Analysator für eine deutsche Kühlschrank-App.
+                    Analysiere diesen Kassenbon (Supermarkt wie Kaufland, Lidl, Rewe, Edeka).
+                    
+                    Ignoriere komplett: Summen, Steuern, Kartenzahlung, Rabatte, Pfand, Adressen und Müll.
+                    
+                    Extrahiere alle gekauften Lebensmittel und Haushaltsartikel. 
+                    Schreibe abgekürzte Artikel vollständig und mit richtiger Marke aus.
+                    
+                    Gib das Ergebnis AUSSCHLIESSLICH im folgenden JSON-Format zurück:
+                    [
+                      {"quantity": 1, "name": "Müller Ayran", "price": 0.88},
+                      {"quantity": 2, "name": "Weihenstephan H-Milch 1,5%", "price": 2.22}
+                    ]
+                """.trimIndent()
+
+                val inputContent = content {
+                    image(bitmap)
+                    text(prompt)
+                }
+
+                val response = generativeModel.generateContent(inputContent)
+                val textResponse = response.text?.replace("```json", "")?.replace("```", "")?.trim() ?: ""
+                
+                val listType = object : TypeToken<List<GeminiProduct>>() {}.type
+                val items: List<GeminiProduct> = Gson().fromJson(textResponse, listType)
+                
+                val products = items.map { 
+                    Product(
+                        name = it.name,
+                        price = it.price,
+                        quantity = it.quantity,
+                        rawText = it.name
+                    )
+                }
+
+                withContext(Dispatchers.Main) {
+                    onResult(products)
+                }
+            } catch (e: Exception) {
+                Log.e("Gemini", "Fehler bei der Analyse", e)
+                withContext(Dispatchers.Main) {
+                    Toast.makeText(this@KassenzettelScannerActivity, "Fehler: ${e.message}", Toast.LENGTH_LONG).show()
+                    onResult(emptyList())
                 }
             }
         }
     }
 
