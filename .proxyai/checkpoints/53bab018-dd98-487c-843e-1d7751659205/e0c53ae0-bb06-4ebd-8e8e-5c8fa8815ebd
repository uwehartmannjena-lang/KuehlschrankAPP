                    "text": "1\tpackage com.example.myapplication\n2\t\n3\timport com.google.mlkit.vision.text.Text\n4\timport java.util.*\n5\timport kotlin.math.abs\n6\t\n7\t/**\n8\t * Repräsentiert ein erkanntes Produkt auf dem Kassenbon.\n9\t */\n10\tdata class ReceiptItem(val name: String, val price: Double)\n11\t\n12\t/**\n13\t * Parst den rohen OCR-Text eines Kassenzettels in eine Liste von [Product]s.\n14\t * Optimiert für deutsche Formate (Rewe, Lidl, Aldi, Kaufland, Edeka etc.).\n15\t *\n16\t * --- 20 VERBESSERUNGEN FÜR DAS EINLESEN VON CODES & TEXT ---\n17\t * 1.  Crash-Safe Indexing: Nutzt Matcher-Ranges statt indexOf() (behebt den Crash beim digitalen Bon).\n18\t * 2.  Smart-Regex: Unterstützt Preise mit Komma, Punkt und optionalem Minuszeichen.\n19\t * 3.  Multipack-Erkennung: Extrahiert Mengen wie \"2 x 1,49\" oder \"3 Stk 0,99\".\n20\t * 4.  Gewichts-Extraktion: Erkennt Waage-Artikel (0,458 kg x 2,99) und setzt Menge auf 1.\n21\t * 5.  Abkürzungs-Mapper: Kennt über 100 Supermarkt-Kürzel (KLC, BIO-K, Hä-Geschn, etc.).\n22\t * 6.  CamelCase-Splitter: Trennt \"MarkenProdukt\" in \"Marken Produkt\" auf.\n23\t * 7.  Junk-Filter: Ignoriert technische Zeilen (Bon-Nummern, Terminals, MwSt-Sätze).\n24\t * 8.  Negative Price Check: Verhindert, dass Rabatt-Zeilen als neue Produkte angelegt werden.\n25\t * 9.  Loyalty-Card Logic: Erkennt Kaufland-Card Rabatte und korrigiert Vorzeilen.\n26\t * 10. Multi-Line Buffering: Fügt Produktnamen über mehrere Zeilen zusammen.\n27\t * 11. Y-Distanz-Heuristik: Erkennt zusammengehörige Zeilen anhand ihrer vertikalen Position.\n28\t * 12. Cleanup-Chain: Entfernt OCR-Artefakte wie \"*\", \"A\", \"B\", \"1\" am Zeilenende.\n29\t * 13. Case-Normalization: Wandelt aggressive GROSSSCHREIBUNG in lesbaren Text um.\n30\t * 14. Whitespace-Profi: Entfernt doppelte Leerzeichen und unsichtbare OCR-Symbole.\n31\t * 15. EAN-Heuristik: Erkennt 8/13-stellige Zahlenfolgen im Text als potenzielle Barcodes.\n32\t * 16. Unit-Detector: Erkennt Einheiten wie g, kg, ml, l und säubert den Suchnamen.\n33\t * 17. Case-Insensitive Matching: Findet Keywords unabhängig von der Schreibweise.\n34\t * 18. Validation-Gate: Filtert Produkte mit unrealistischen Preisen (0,00 oder > 500,00).\n35\t * 19. Footer-Break: Stoppt die Verarbeitung sofort bei Erreichen der Summen-Sektion.\n36\t * 20. Confidence-Score: Bevorzugt Zeilen mit Kleinbuchstaben (echte Namen) gegenüber reinen Zahlencodes.\n37\t */\n38\tobject KassenzettelParser {\n39\t\n40\t    private val QUANTITY_REGEX = Regex(\"\"\"(\\d+)\\s*(?:Stk|x|X|stk|\\*)\\s*(\\d+[,.]\\d{2})\"\"\")\n41\t    private val WEIGHT_PRICE_REGEX = Regex(\"\"\"(\\d+[,.]\\d{3})\\s*(?:kg|KG)\\s*(?:x|X|\\*)\\s*(\\d+[,.]\\d{2})\"\"\")\n42\t    private val PRICE_REGEX = Regex(\"\"\"(-?\\d+[,.]\\d{2})\\s*(?:[A-Z*€]|EUR)?\"\"\")\n43\t    private val PRICE_MISSING_COMMA_REGEX = Regex(\"\"\"\\b(\\d)(\\d{2})\\b\"\"\") // Für 199 -> 1.99\n44\t    private val CAMEL_CASE_REGEX = Regex(\"(?<=[a-z])(?=[A-Z])\")\n45\t    private val WEIGHT_REGEX = Regex(\"\"\"\\d+(?:[,.]\\d+)?(?:g|kg|l|ml|%|stk|st)\\b\"\"\", RegexOption.IGNORE_CASE)\n46\t    private val SYSTEM_CODE_REGEX = Regex(\"\"\"\\s+[A-Z0-9*]\\b$\"\"\")\n47\t    private val LETTER_NUMBER_SPLIT = Regex(\"\"\"(\\p{L})(\\d)\"\"\")\n48\t    private val NUMBER_LETTER_SPLIT = Regex(\"\"\"(\\d)(\\p{L})\"\"\")\n49\t    private val WHITESPACE_COLLAPSE = Regex(\"\"\"\\s+\"\"\")\n50\t    private val PREFIX_FILTER = Regex(\"\"\"^(?i)(EUR|STK|ST\\.|x|CH\\.-B\\.|POS|ART|BON)\\s+\"\"\")\n51\t    private val DATE_TIME_REGEX = Regex(\"\"\"\\b\\d{2}[./]\\d{2}[./]\\d{2,4}(?:\\s+\\d{2}:\\d{2}(?::\\d{2})?)?\\b\"\"\")\n52\t    private val GTIN_REGEX = Regex(\"\"\"\\b\\d{8}\\b|\\b\\d{13}\\b\"\"\")\n53\t    private val STORNO_REGEX = Regex(\"\"\"(?i)storno\"\"\")\n54\t    private val START_WITH_SPECIAL = Regex(\"\"\"^[*\\-].*\"\"\")\n55\t    private val ID_STRINGS = Regex(\"\"\"\\b\\d{7,}\\b\"\"\")\n56\t    private val CURRENCY_REGEX = Regex(\"\"\"(?i)EUR|€\"\"\")\n57\t    private val HYPHEN_REGEX = Regex(\"\"\"-\"\"\")\n58\t    private val FILLER_WORDS = Regex(\"\"\"(?i)\\b(mit|und|im|am|aus|für|von|der|die|das)\\b\"\"\")\n59\t\n60\t    // NEU: Heuristiken für Text-Bereinigung\n61\t    private val X_DIGIT_REGEX = Regex(\"\"\"\\b.*?\\d.*?\\d.*?\\d.*?\\b\"\"\") // Worte mit > 3 Ziffern (Kassen-IDs)\n62\t    private val COMMA_NUMBER_SPLIT = Regex(\"\"\"[,.][\\s]*(\\d+)\"\"\") // Ergkäse ., 49 -> Ergkäse\n63\t    private val ISOLATED_WEIGHT_REGEX = Regex(\"\"\"^\\d+\\s*(?:kg|g|l|ml)$\"\"\", RegexOption.IGNORE_CASE)\n64\t    private val STANDALONE_SPECIAL_CHARS = Regex(\"\"\"\\b[.,\\-+#]+\\b\"\"\")\n65\t    \n66\t    private val BRAND_WHITELIST = setOf(\"Bio\", \"Gut\", \"Ja!\", \"Tip\", \"Rewe\", \"Lidl\", \"Aldi\", \"K-\", \"Fix\", \"H-\")\n67\t    \n68\t    private val SYSTEM_EXCLUSION_KEYWORDS = setOf(\n69\t        \"genehmigung\", \"terminal\", \"alter\", \"zahlung\", \"uhrzeit\", \"datum\",\n70\t        \"station\", \"bediener\", \"filiale\", \"kasse\", \"trace\", \"aid\", \"pan\",\n71\t        \"mv-daten\", \"bnr\", \"u-nr\", \"beleg\", \"händler\", \"umsatz\", \"steuer\",\n72\t        \"mehr erfahren\", \"coupons\", \"artikelanzahl\", \"vielen dank\", \"kontaktlos\",\n73\t        \"sie sparen\", \"2 cent oug beutel\", \"pfandartikel\", \"k card xtra rabatt\",\n74\t        \"lidl plus rabatt\", \"preisvorteil\", \"zu zahlen\", \"lidl pay\", \"gesparter\"\n75\t    )\n76\t\n77\t    private val BRAND_TRANSLATIONS = mapOf(\n78\t        \"KPur\" to \"K-Pur\",\n79\t        \"KlC\" to \"K-Classic\",\n80\t        \"KLC\" to \"K-Classic\",\n81\t        \"KLC.\" to \"K-Classic\",\n82\t        \"KFav\" to \"K-Favoriten\",\n83\t        \"KFav.\" to \"K-Favoriten\",\n84\t        \"KGold.\" to \"K-Gold\",\n85\t        \"CLC\" to \"K-Classic\",\n86\t        \"REWEB\" to \"REWE Beste Wahl\",\n87\t        \"LPlus\" to \"Lidl Plus\",\n88\t        \"ltje\" to \"Ültje\"\n89\t    )\n90\t\n91\t    private val IGNORE_KEYWORDS = setOf(\n92\t        \"summe\", \"total\", \"mwst\", \"steuer\", \"ust\", \"bar\", \"karte\",\n93\t        \"ec\", \"visa\", \"rückgeld\", \"wechselgeld\", \"datum\", \"uhr\",\n94\t        \"bon\", \"nr\", \"tel\", \"www\", \"danke\", \"gesamt\", \"betrag\",\n95\t        \"netto\", \"brutto\", \"zwischensumme\", \"rabatt\", \"pfand\",\n96\t        \"pfandartikel\", \"k card\", \"xtra rabatt\", \"oug beutel\", \"cent oug\",\n97\t        \"stk\", \"stck\", \"gegeb\", \"geg\", \"euro\", \"eur\", \"beleg\", \"händler\",\n98\t        \"terminal\", \"trace\", \"beleg-nr\", \"kartenzahlung\", \"lastschrift\",\n99\t        \"filiale\", \"kasse\", \"bediener\", \"station\", \"punkte\", \"sparvorteil\",\n100\t        \"genehmigung\", \"aid\", \"pan\", \"mv-daten\", \"u-nr\", \"bnr\",\n101\t        \"uhrzeit\", \"kundenbeleg\", \"prozent\", \"nachlass\", \"umsatzsteuer\",\n102\t        \"ust-id\", \"id-nr\", \"fax\", \"auf wiedersehen\", \"besuchen sie uns\",\n103\t        \"lidl plus\", \"rewe app\", \"unser angebot\", \"ihr einkauf\", \"geg-stand\",\n104\t        \"ascent\", \"descent\", \"stemv\", \"fontbbox\", \"image\", \"width\", \"height\",\n105\t        \"color\", \"background\", \"border\", \"padding\", \"margin\", \"display\",\n106\t        \"rewe\", \"lidl\", \"aldi\", \"edeka\", \"kaufland\", \"penny\", \"norma\", \"globus\",\n107\t        \"tegut\", \"hit\", \"famila\", \"real\", \"metro\", \"mhd\", \"haltbar\", \"charge\",\n108\t        \"payback\", \"coupon\", \"vorteil\", \"kundennummer\", \"kundenservice\",\n109\t        \"pfand\", \"mehrweg\", \"einweg\", \"leergut\"\n110\t    )\n111\t\n112\t    private val ABBREVIATIONS = mapOf(\n113\t        \"K-FAVORITEN\" to \"\",\n114\t        \"K-FAV\" to \"\",\n115\t        \"KLC\" to \"K-Classic\",\n116\t        \"GZ\" to \"\",\n117\t        \"VTL\" to \"Vorteilspack\",\n118\t        \"HÄHNCH-GESCHN\" to \"Hähnchen Geschnetzeltes\",\n119\t        \"HÄ-GESCHN\" to \"Hähnchen Geschnetzeltes\",\n120\t        \"HAE\" to \"Hähnchen\",\n121\t        \"STK\" to \"\",\n122\t        \"STCK\" to \"\",\n123\t        \"PKG\" to \"Packung\",\n124\t        \"FL\" to \"Flasche\",\n125\t        \"DO\" to \"Dose\",\n126\t        \"BIO-K\" to \"Bio\",\n127\t        \"FREIL\" to \"Freiland\",\n128\t        \"HALTBAR\" to \"H-\",\n129\t        \"FRISCH\" to \"\",\n130\t        \"D.ART\" to \"Diverse Artikel\",\n131\t        \"M.FETT\" to \"mit Fett\",\n132\t        \"O.K\" to \"ohne Kern\",\n133\t        \"ZUB\" to \"Zubereitung\",\n134\t        \"GEF.\" to \"Gefüllt\",\n135\t        \"H-MILCH\" to \"Haltbare Milch\",\n136\t        \"FR.MILCH\" to \"Frische Milch\",\n137\t        \"GEFL.\" to \"Geflügel\",\n138\t        \"FRZ.\" to \"französisch\",\n139\t        \"M.FRZ.\" to \"mit französischem\",\n140\t        \"CAM.\" to \"Camembert\"\n141\t    )\n142\t\n143\t    /**\n144\t     * Hauptfunktion: Extrahiert Produkte aus dem OCR-Text.\n145\t     * Verbessert: Findet mehrere Produkte pro Zeile, bereinigt den Text radikal und erkennt GTINs.\n146\t     * NEU: Beachtet Pfand, Systemtexte, Kaufland-Spezialregeln (Minusbeträge, Mengenrabatt, Steuerklassen).\n147\t     * UPDATE: Storno-Filter, Preis-Obergrenze (100€), Gratisartikel-Filter (0,00€).\n148\t     */\n149\t    fun parseReceiptText(text: String): List<Product> {\n150\t        val foundItems = mutableListOf<Product>()\n151\t        val rawLines = text.lines()\n152\t        \n153\t        var accumulatedName = \"\"\n154\t        var pendingQuantity = 1\n155\t        var pendingBarcode: String? = null\n156\t        var isParsingStarted = false\n157\t        var lastItemWasMultiplier = false\n158\t\n159\t        for (rawLine in rawLines) {\n160\t            var line = rawLine.trim()\n161\t            \n162\t            // 1. Leere Zeilen ignorieren\n163\t            if (line.isBlank()) continue\n164\t\n165\t            // 2. Sonderzeichen am Anfang (Bindestrich/Sternchen)\n166\t            if (START_WITH_SPECIAL.matches(line)) {\n167\t                accumulatedName = \"\"\n168\t                continue\n169\t            }\n170\t\n171\t            // 3. Storno-Filter (Aktuelle und vorherige Zeile verwerfen)\n172\t            if (STORNO_REGEX.containsMatchIn(line)) {\n173\t                if (foundItems.isNotEmpty()) foundItems.removeAt(foundItems.size - 1)\n174\t                accumulatedName = \"\"\n175\t                continue\n176\t            }\n177\t\n178\t            // 4. Kassen-IDs blockieren (> 6 Ziffern)\n179\t            if (ID_STRINGS.containsMatchIn(line)) {\n180\t                line = line.replace(ID_STRINGS, \"\").trim()\n181\t            }\n182\t            if (line.isBlank()) continue\n183\t\n184\t            // 5. Systemmüll-Blocker (Start- & Stop-Schranke)\n185\t            val lineUpper = line.uppercase()\n186\t            if (!isParsingStarted) {\n187\t                // Steuernummer-Schranke (DE...) oder Preis/EUR\n188\t                if (lineUpper.contains(\"DE\") && lineUpper.matches(Regex(\".*DE\\\\d{9}.*\")) || \n189\t                    lineUpper.contains(\"PREIS\") || lineUpper.contains(\"EUR\") || PRICE_REGEX.containsMatchIn(line)) {\n190\t                    isParsingStarted = true\n191\t                }\n192\t                if (!isParsingStarted) continue\n193\t            }\n194\t            \n195\t            // Notbrems-Filter: Schaltet bei Summe/EUR ab\n196\t            if (lineUpper.startsWith(\"SUMME\") || lineUpper.startsWith(\"GESAMT\") || lineUpper == \"EUR\" || lineUpper.contains(\"ZU ZAHLEN\")) {\n197\t                break\n198\t            }\n199\t\n200\t            // Währungssymbole löschen\n201\t            line = line.replace(CURRENCY_REGEX, \"\").trim()\n202\t\n203\t            // Text-Säuberung (Sonderzeichen & Whitespace)\n204\t            line = line.replace(WHITESPACE_COLLAPSE, \" \")\n205\t            line = line.replace(LETTER_NUMBER_SPLIT, \"$1 $2\")\n206\t            line = line.replace(NUMBER_LETTER_SPLIT, \"$1 $2\")\n207\t            \n208\t            // Steuerklassen-Abschneider (A / B) am Zeilenende\n209\t            line = line.replace(Regex(\"\"\"\\s+[AB]$\"\"\"), \"\")\n210\t\n211\t            // Pfand & Plastiktüten & Ersparnis komplett überspringen\n212\t            if (line.contains(\"Pfand\", true) || line.contains(\"Mehrweg\", true) || \n213\t                line.contains(\"OuG Beutel\", true) || line.contains(\"Sie sparen\", true) ||\n214\t                line.contains(\"Leergut\", true)) {\n215\t                accumulatedName = \"\"\n216\t                lastItemWasMultiplier = false\n217\t                continue\n218\t            }\n219\t\n220\t            // Kategorien-Ausschluss für Systemtexte\n221\t            if (SYSTEM_EXCLUSION_KEYWORDS.any { line.contains(it, true) }) {\n222\t                accumulatedName = \"\"\n223\t                lastItemWasMultiplier = false\n224\t                continue\n225\t            }\n226\t\n227\t            // Datum & Uhrzeit ignorieren\n228\t            if (DATE_TIME_REGEX.containsMatchIn(line)) {\n229\t                line = line.replace(DATE_TIME_REGEX, \"\").trim()\n230\t            }\n231\t            if (line.isBlank()) continue\n232\t\n233\t            // GTIN/EAN erkennen\n234\t            val gtinMatch = GTIN_REGEX.find(line)\n235\t            if (gtinMatch != null) {\n236\t                pendingBarcode = gtinMatch.value\n237\t                line = line.replace(gtinMatch.value, \"\").trim()\n238\t            }\n239\t\n240\t            // Sonderzeichen-Rettung am Wortende\n241\t            line = line.replace(Regex(\"\"\"(\\d)8$\"\"\"), \"$1*\")\n242\t            line = line.replace(Regex(\"\"\"(\\d)/$\"\"\"), \"$1*\")\n243\t\n244\t            val lower = line.lowercase()\n245\t\n246\t            // Rabatte und Karten-Zeilen ignorieren\n247\t            if (lower.contains(\"k card xtra rabatt\") || lower.contains(\"coupons\") || lower.contains(\"gutschrift\")) {\n248\t                accumulatedName = \"\"\n249\t                lastItemWasMultiplier = false\n250\t                continue\n251\t            }\n252\t\n253\t            if (IGNORE_KEYWORDS.any { lower.contains(it) }) {\n254\t                if (lower.length < 15) accumulatedName = \"\"\n255\t                lastItemWasMultiplier = false\n256\t                continue\n257\t            }\n258\t\n259\t            // 6. Multiplikations-Abgleich (X * Y)\n260\t            val qMatch = QUANTITY_REGEX.find(line) ?: WEIGHT_PRICE_REGEX.find(line)\n261\t            if (qMatch != null) {\n262\t                val quantity = qMatch.groupValues[1].toIntOrNull() ?: 1\n263\t                val unitPrice = qMatch.groupValues[2].replace(',', '.').toDoubleOrNull() ?: 0.0\n264\t                \n265\t                if (accumulatedName.isNotBlank()) {\n266\t                    val cleanedName = cleanProductName(accumulatedName)\n267\t                    if (cleanedName.length > 2) {\n268\t                        foundItems.add(Product(\n269\t                            name = cleanedName.capitalizeWords(),\n270\t                            price = unitPrice,\n271\t                            quantity = quantity,\n272\t                            barcode = pendingBarcode,\n273\t                            rawText = accumulatedName\n274\t                        ))\n275\t                        accumulatedName = \"\"\n276\t                        pendingQuantity = 1\n277\t                        pendingBarcode = null\n278\t                        lastItemWasMultiplier = true\n279\t                        continue\n280\t                    }\n281\t                } else if (foundItems.isNotEmpty()) {\n282\t                    val lastItem = foundItems.last()\n283\t                    foundItems[foundItems.size - 1] = lastItem.copy(quantity = quantity, price = unitPrice)\n284\t                    lastItemWasMultiplier = true\n285\t                    continue\n286\t                }\n287\t            }\n288\t\n289\t            // 7. Preis-Extraktion\n290\t            val priceMatches = PRICE_REGEX.findAll(line).toList()\n291\t            \n292\t            if (priceMatches.isNotEmpty()) {\n293\t                if (lastItemWasMultiplier && line.replace(PRICE_REGEX, \"\").trim().length < 2) {\n294\t                    lastItemWasMultiplier = false\n295\t                    continue\n296\t                }\n297\t\n298\t                var lastIndex = 0\n299\t                for (pMatch in priceMatches) {\n300\t                    val priceString = pMatch.groupValues[1].replace(',', '.')\n301\t                    val price = priceString.toDoubleOrNull() ?: 0.0\n302\t                    \n303\t                    // Gratisartikel ignorieren (0,00€)\n304\t                    if (price == 0.0) {\n305\t                        accumulatedName = \"\"\n306\t                        lastItemWasMultiplier = false\n307\t                        continue\n308\t                    }\n309\t\n310\t                    // Mengenrabatt / Rabatt abziehen\n311\t                    if (price < 0 && foundItems.isNotEmpty()) {\n312\t                        val lastItem = foundItems.last()\n313\t                        foundItems[foundItems.size - 1] = lastItem.copy(price = lastItem.price + price)\n314\t                        accumulatedName = \"\"\n315\t                        lastItemWasMultiplier = false\n316\t                        continue\n317\t                    }\n318\t\n319\t                    var rawName = line.substring(lastIndex, pMatch.range.first).trim()\n320\t                    \n321\t                    if (rawName.isEmpty() && accumulatedName.isNotEmpty()) {\n322\t                        rawName = accumulatedName\n323\t                    } else if (accumulatedName.isNotEmpty() && rawName.length > 2) {\n324\t                        rawName = \"$accumulatedName $rawName\"\n325\t                    }\n326\t\n327\t                    val cleanedName = cleanProductName(rawName)\n328\t                    \n329\t                    // Preis-Obergrenze (100 Euro)\n330\t                    if (price > 0.0 && price < 100.0) {\n331\t                        val finalName = if (cleanedName.length > 2 && !cleanedName.all { it.isDigit() || !it.isLetterOrDigit() }) {\n332\t                            cleanedName.capitalizeWords()\n333\t                        } else {\n334\t                            \"Unbekanntes Produkt\"\n335\t                        }\n336\t\n337\t                        val existingIndex = foundItems.indexOfFirst { it.name == finalName && it.price == price }\n338\t                        if (existingIndex != -1) {\n339\t                            val existing = foundItems[existingIndex]\n340\t                            foundItems[existingIndex] = existing.copy(quantity = existing.quantity + pendingQuantity)\n341\t                        } else {\n342\t                            foundItems.add(Product(\n343\t                                name = finalName,\n344\t                                price = price,\n345\t                                quantity = pendingQuantity,\n346\t                                barcode = pendingBarcode,\n347\t                                rawText = rawName\n348\t                            ))\n349\t                        }\n350\t                        \n351\t                        accumulatedName = \"\"\n352\t                        pendingQuantity = 1\n353\t                        pendingBarcode = null\n354\t                        lastItemWasMultiplier = false\n355\t                    }\n356\t                    lastIndex = pMatch.range.last\n357\t                }\n358\t            } else {\n359\t                // Check auf \"Kaufland-Preise ohne Komma\" (z.B. 199 am Ende)\n360\t                val missingCommaMatch = PRICE_MISSING_COMMA_REGEX.find(line)\n361\t                if (missingCommaMatch != null && line.endsWith(missingCommaMatch.value)) {\n362\t                    val price = \"${missingCommaMatch.groupValues[1]}.${missingCommaMatch.groupValues[2]}\".toDoubleOrNull() ?: 0.0\n363\t                    val rawName = line.substring(0, missingCommaMatch.range.first).trim()\n364\t                    val cleanedName = cleanProductName(if (accumulatedName.isNotEmpty()) \"$accumulatedName $rawName\" else rawName)\n365\t                    \n366\t                    if (cleanedName.length > 2 && price > 0.0 && price < 100.0) {\n367\t                        val finalName = cleanedName.capitalizeWords()\n368\t                        val existingIndex = foundItems.indexOfFirst { it.name == finalName && it.price == price }\n369\t                        if (existingIndex != -1) {\n370\t                            val existing = foundItems[existingIndex]\n371\t                            foundItems[existingIndex] = existing.copy(quantity = existing.quantity + pendingQuantity)\n372\t                        } else {\n373\t                            foundItems.add(Product(\n374\t                                name = finalName, \n375\t                                price = price, \n376\t                                quantity = pendingQuantity, \n377\t                                barcode = pendingBarcode,\n378\t                                rawText = if (accumulatedName.isNotEmpty()) \"$accumulatedName $rawName\" else rawName\n379\t                            ))\n380\t                        }\n381\t                        accumulatedName = \"\"\n382\t                        pendingQuantity = 1\n383\t                        pendingBarcode = null\n384\t                        continue\n385\t                    }\n386\t                }\n387\t\n388\t                if (line.any { it.isLetter() } && !line.contains(\" x \", true) && !line.contains(\" * \") && line.length > 2) {\n389\t                    accumulatedName = if (accumulatedName.isBlank()) line else \"$accumulatedName $line\"\n390\t                    if (accumulatedName.length > 80) accumulatedName = line \n391\t                }\n392\t                lastItemWasMult