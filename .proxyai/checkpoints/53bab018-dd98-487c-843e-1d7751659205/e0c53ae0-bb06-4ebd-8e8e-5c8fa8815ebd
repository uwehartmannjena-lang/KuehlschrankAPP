                .trim()\n45\t                    .capitalizeWords()\n46\t                val preisString = treffer.groupValues[3].replace(\",\", \".\")\n47\t                val preis = preisString.toDoubleOrNull() ?: return@forEach\n48\t\n49\t                // Artikel mit 0,00 € überspringen (Pflichtangaben, keine echten Produkte)\n50\t                if (preis <= 0.0) return@forEach\n51\t\n52\t                ergebnis.add(ScannedItem(name = name, preis = preis, menge = menge))\n53\t            }\n54\t        }\n55\t\n56\t        return ergebnis\n57\t    }\n58\t\n59\t    /**\n60\t     * Hilfsfunktion: Ersten Buchstaben jedes Wortes großschreiben.\n61\t     */\n62\t    private fun String.capitalizeWords(): String =\n63\t        split(\" \").joinToString(\" \") { word ->\n64\t            word.replaceFirstChar { it.uppercaseChar() }\n65\t        }\n66\t}"
